{
    "name": "aotr/laravel-animated-icons",
    "description": "Plug-and-play animated SVG icons for Laravel Blade: hover, click, auto and on-view triggers, registry sync, reduced motion and Livewire-safe delegation.",
    "keywords": ["laravel", "icons", "animated", "lucide", "blade", "svg", "micro-interactions"],
    "license": "MIT",
    "type": "library",
    "version": "1.0.0",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Aotr\\AnimatedIcons\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aotr\\AnimatedIcons\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aotr\\AnimatedIcons\\AnimatedIconsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
